<Window x:Class="XDVPN.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="XD VPN" Width="1060" Height="790" MinWidth="1000" MinHeight="740" Background="{StaticResource CanvasBrush}" FontFamily="Segoe UI, Microsoft YaHei UI" WindowStartupLocation="CenterScreen" Closing="WindowClosing">
 <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/></Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="204"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#192D27"><DockPanel>
   <StackPanel DockPanel.Dock="Top" Margin="0,44,0,0">
    <StackPanel Orientation="Horizontal" Margin="23,0,0,0"><Border Background="#C3E8D3" CornerRadius="12" Width="40" Height="40"><TextBlock Text="◇" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="11,0,0,0"><TextBlock Text="XD VPN" Foreground="White" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="YOUR PRIVATE LINK" Foreground="#83998D" FontSize="8"/></StackPanel></StackPanel>
    <TextBlock Text="工作空间" Foreground="#83998D" FontSize="11" Margin="26,45,0,13"/>
    <RadioButton x:Name="ConnectionNav" Style="{StaticResource Nav}" Content="◈    网络连接" Tag="Connection" IsChecked="True" Checked="Navigate"/>
    <RadioButton Style="{StaticResource Nav}" Content="◴    连接质量" Tag="Quality" Checked="Navigate"/>
    <RadioButton Style="{StaticResource Nav}" Content="⚙    VPN 配置" Tag="Profile" Checked="Navigate"/>
    <RadioButton Style="{StaticResource Nav}" Content="☷    连接日志" Tag="Activity" Checked="Navigate"/>
   </StackPanel>
   <StackPanel DockPanel.Dock="Bottom" Margin="25,0,23,24"><TextBlock Text="♧" FontSize="26" Foreground="#B5D8C1"/><TextBlock Text="少一点操作，&#x0a;多一点专注。" FontSize="16" LineHeight="28" Foreground="#CED9D0" Margin="0,12,0,9"/><TextBlock Text="让连接安静地发生。" FontSize="10" Foreground="#83998D"/><Border Height="1" Background="#35463E" Margin="0,28,0,18"/><TextBlock Text="WINDOWS · 预览版" Foreground="#83998D" FontSize="10"/></StackPanel>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="32,32,32,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,22"><Border DockPanel.Dock="Right" CornerRadius="16" Background="White" Padding="13,9" VerticalAlignment="Center"><TextBlock Text="▣  此 Windows PC" Style="{StaticResource Caption}"/></Border><StackPanel><TextBlock x:Name="Eyebrow" Text="A LITTLE CLOSER TO WORK" Style="{StaticResource Caption}"/><TextBlock x:Name="PageTitle" Text="工作网络，一键就绪。" FontSize="28" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></DockPanel>
   <Border Grid.Row="1" Background="#FFF1DD" CornerRadius="12" Padding="13" Margin="0,0,0,16" Visibility="{Binding HasIssue, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding Issue}" Foreground="#946B37" FontSize="12"/></Border>
   <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid>
     <StackPanel x:Name="ConnectionPage">
      <Border Style="{StaticResource Card}" Padding="15" Margin="0,0,0,16"><DockPanel><Button DockPanel.Dock="Right" Content="重新检测" Style="{StaticResource Secondary}" Click="RefreshService" FontSize="11" Padding="12,8"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding ServiceMessage}" FontSize="12"/><TextBlock Text="首次使用请运行安装包中的 Install.cmd，完成一次系统授权。" Style="{StaticResource Caption}" Margin="0,4,8,0"/></StackPanel></DockPanel></Border>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="226"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource Card}" Padding="22"><StackPanel>
        <DockPanel><TextBlock Text="{Binding StatusLabel}" DockPanel.Dock="Right" Foreground="{StaticResource Green}" FontSize="11"/><TextBlock Text="CONNECTION" Style="{StaticResource Caption}"/></DockPanel>
        <Grid Height="170" Margin="0,5,0,0" IsHitTestVisible="False">
         <Ellipse Width="155" Height="155" Stroke="#E0EBE1"/><Ellipse Width="120" Height="120" Stroke="#CBDFD0"/><Ellipse Width="82" Height="82" Fill="#DAEFE3"/>
         <Path Data="M 0,0 L 24,8 L 24,27 C 24,40 0,52 0,52 C 0,52 -24,40 -24,27 L -24,8 Z" Fill="#227858" Stretch="Uniform" Width="42" Height="48"/><TextBlock Text="✓" Foreground="White" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
         <Ellipse Width="8" Height="8" Fill="#86B798" Margin="0,0,110,96"/>
        </Grid>
        <TextBlock Text="{Binding Title}" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"/>
        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" TextAlignment="Center" MinHeight="32" Margin="0,7,0,15"/>
        <Button Content="{Binding ActionTitle}" IsEnabled="{Binding CanAct}" Click="ConnectionAction" Width="216"/>
        <Border Height="1" Background="#E6EAE3" Margin="0,22,0,16"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="连接时长" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Duration}" FontSize="16" Margin="0,7,0,0" FontFamily="Consolas"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="分配地址" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Address}" FontSize="16" Margin="0,7,0,0" FontFamily="Consolas"/></StackPanel></Grid>
       </StackPanel></Border>
       <StackPanel Grid.Column="2"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="当前配置" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Profile.Name}" FontSize="18" FontWeight="SemiBold" Margin="0,15,0,18"/><TextBlock Text="服务器" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Profile.Server}" FontSize="12" Margin="0,6,0,18"/><TextBlock Text="VPN 账号" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Profile.Username}" FontSize="12" Margin="0,6,0,0"/></StackPanel></Border>
        <Border Style="{StaticResource Card}" Background="#EDF1E9" Margin="0,18,0,0"><StackPanel><TextBlock Text="凭据，只留在本机。" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="VPN 密码安全保存在 Windows 凭据管理器中。连接时验证服务器证书。" Style="{StaticResource Caption}" Margin="0,10,0,0" LineHeight="19"/></StackPanel></Border>
       </StackPanel>
      </Grid>
      <Border Style="{StaticResource Card}" Padding="20" Margin="0,18,0,0"><DockPanel><CheckBox x:Name="AutoToggle" DockPanel.Dock="Right" IsChecked="{Binding AutoConnect, Mode=OneWay}" Click="AutoChanged" Content="Auto Connect"/><StackPanel><TextBlock Text="让连接自动发生" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="启动时连接，掉线后自动重试；手动断开会保持断开。" Style="{StaticResource Caption}" Margin="0,6,14,0"/></StackPanel></DockPanel></Border>
      <Border Background="#EDF1E9" CornerRadius="16" Padding="18" Margin="0,14,0,0"><DockPanel><CheckBox x:Name="StartupToggle" DockPanel.Dock="Right" Content="登录后启动" IsChecked="{Binding LaunchAtLogin, Mode=OneWay}" Click="StartupChanged"/><TextBlock Text="登录 Windows 后，在托盘中准备好工作网络。" Style="{StaticResource Caption}" VerticalAlignment="Center"/></DockPanel></Border>
      <TextBlock Text="凭据留在你的电脑，连接交给 XD VPN。" Style="{StaticResource Caption}" Margin="2,16,0,4"/>
     </StackPanel>
     <StackPanel x:Name="ProfilePage" Visibility="Collapsed" IsEnabled="{Binding CanEdit}"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="你的工作网络" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,22"/><TextBlock Text="配置名称"/><TextBox x:Name="ProfileName" AutomationProperties.Name="配置名称" MaxLength="1024"/><TextBlock Text="VPN 服务器"/><TextBox x:Name="Server" AutomationProperties.Name="VPN 服务器" MaxLength="1024"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="VPN 账号"/><TextBox x:Name="Username" AutomationProperties.Name="VPN 账号" MaxLength="1024"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="认证组（可选）"/><TextBox x:Name="AuthGroup" AutomationProperties.Name="认证组" MaxLength="1024"/></StackPanel></Grid><TextBlock Text="VPN 密码"/><PasswordBox x:Name="Password" AutomationProperties.Name="VPN 密码" MaxLength="2048"/><TextBlock Text="留空保留此账号的已存密码。更换服务器、账号或认证组后需要重新填写。" Style="{StaticResource Caption}"/><StackPanel Orientation="Horizontal" Margin="0,24,0,0"><Button Content="保存配置" Click="SaveProfile" Width="160"/><Button Content="忘记已存密码" Click="ForgetPassword" Style="{StaticResource Secondary}" Margin="12,0,0,0"/></StackPanel></StackPanel></Border></StackPanel>
     <StackPanel x:Name="QualityPage" Visibility="Collapsed"><TextBlock Text="{Binding QualityNote}" Style="{StaticResource Caption}" Margin="0,0,0,18"/><UniformGrid Columns="3"><Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="连接成功率" Style="{StaticResource Caption}"/><TextBlock Text="{Binding SuccessRate}" FontSize="32" FontWeight="SemiBold" Margin="0,18,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="连接耗时 P95" Style="{StaticResource Caption}"/><TextBlock Text="{Binding P95}" FontSize="30" FontWeight="SemiBold" Margin="0,18,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="恢复次数" Style="{StaticResource Caption}"/><TextBlock Text="{Binding RecoveryCount}" FontSize="32" FontWeight="SemiBold" Margin="0,18,0,0"/></StackPanel></Border></UniformGrid><Border Style="{StaticResource Card}" Margin="0,20,0,0"><StackPanel><TextBlock Text="最近的连接" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding QualitySamples}" FontFamily="Consolas" FontSize="13" LineHeight="32" Margin="0,18,0,0"/></StackPanel></Border><TextBlock Text="统计来自本机保留日志，不上传到服务器。日志轮转后可能不足 24 小时。" Style="{StaticResource Caption}" Margin="0,18,0,0"/></StackPanel>
     <StackPanel x:Name="ActivityPage" Visibility="Collapsed"><StackPanel Orientation="Horizontal" Margin="0,0,0,18"><Button Content="复制日志" Click="CopyLogs" Style="{StaticResource Secondary}"/><Button Content="清空本次列表" Click="ClearLogs" Style="{StaticResource Secondary}" Margin="10,0,0,0"/><Button Content="打开日志目录" Click="OpenLogs" Style="{StaticResource Secondary}" Margin="10,0,0,0"/></StackPanel><Border Style="{StaticResource Card}"><ListBox ItemsSource="{Binding Events}" BorderThickness="0" Background="Transparent" FontSize="12" Height="440" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,7"/></DataTemplate></ListBox.ItemTemplate></ListBox></Border><TextBlock Text="仅记录连接状态和已分类错误，不记录密码、Cookie 或认证正文。" Style="{StaticResource Caption}" Margin="0,16,0,0"/></StackPanel>
    </Grid>
   </ScrollViewer>
  </Grid>
 </Grid>
</Window>
